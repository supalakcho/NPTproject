NODE_ENV=development
PORT=3000
# XAMPP defaults: MySQL on port 3306, user root, empty password
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=usermgmt
# Required, >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_ISSUER=user-management
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
# Comma-separated origins allowed to call the API from a browser (leave empty when UI is served by this app)
CORS_ORIGINS=
# Set true only behind a reverse proxy / load balancer so req.ip is the client IP
TRUST_PROXY=false
# Used once by `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
